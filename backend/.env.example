# Claude Orchestrator — backend config (all optional; these are the defaults)
# Copy to .env and edit as needed. Env vars are prefixed with CO_.

CO_DATABASE_URL=sqlite+aiosqlite:///./claude_orchestrator.db
CO_WORKSPACES_DIR=./workspaces
CO_CLAUDE_BIN=claude
CO_DEFAULT_MODEL=sonnet
CO_DEFAULT_MAX_TURNS=25
CO_WORKER_CONCURRENCY=3
CO_TASK_TIMEOUT_SECONDS=1800
# Permission mode passed to the Claude CLI for each task. Tasks run in an
# isolated per-task workspace directory. "bypassPermissions" lets tasks act
# autonomously (needed for real work); tighten to "acceptEdits" or "default"
# if you want more guardrails. Phase 5 adds a proper approval workflow.
CO_CLAUDE_PERMISSION_MODE=bypassPermissions

# Credential vault (Phase 2 MCP secrets). If unset, a random 32-byte key is
# generated once and stored at CO_SECRET_KEY_FILE (chmod 600). Set explicitly
# (urlsafe-base64 of 32 bytes) to share a key across machines / restarts.
# CO_SECRET_KEY=
CO_SECRET_KEY_FILE=./.secret.key

# MCP health-check loop interval and per-probe timeout (seconds).
CO_MCP_HEALTH_INTERVAL_SECONDS=300
CO_MCP_PROBE_TIMEOUT_SECONDS=15
